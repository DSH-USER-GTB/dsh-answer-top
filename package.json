    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "scroll",
    "ux"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DSH-USER-GTB/dsh-answer-top.git"
  },
  "homepage": "https://github.com/DSH-USER-GTB/dsh-answer-top#readme",
  "bugs": {
    "url": "https://github.com/DSH-USER-GTB/dsh-answer-top/issues"
  },
  "author": "dsh-answer-top contributors",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "license": "MIT"
